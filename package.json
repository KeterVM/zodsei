{
  "name": "zodsei",
  "version": "2.0.0",
  "description": "Contract-first type-safe HTTP client with Zod validation",
  "keywords": [
    "api-client",
    "contract-first",
    "http-client",
    "type-safe",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/KeterVM/zodsei#readme",
  "bugs": {
    "url": "https://github.com/KeterVM/zodsei/issues"
  },
  "license": "MIT",
  "author": "Your Name",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeterVM/zodsei.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vue-query": {
      "types": "./dist/vue-query.d.ts",
      "import": "./dist/vue-query.js",
      "default": "./dist/vue-query.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dev": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit && tsc --noEmit -p tests/types/tsconfig.json",
    "lint": "oxlint src tests examples *.config.ts",
    "lint:fix": "oxlint --fix src tests examples *.config.ts",
    "format": "oxfmt --write src tests examples *.config.ts *.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src tests examples *.config.ts *.json .oxlintrc.json .oxfmtrc.json",
    "check": "bun run format:check && bun run lint && bun run type-check && bun run test",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run check && bun run build"
  },
  "dependencies": {
    "axios": "^1.21.0"
  },
  "devDependencies": {
    "@tanstack/vue-query": "^5.106.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@tanstack/vue-query": "^5.106.1",
    "vue": "^3.3.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@tanstack/vue-query": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "packageManager": "bun@1.3.14"
}
