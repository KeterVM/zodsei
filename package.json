{
  "name": "zodsei",
  "version": "3.0.0",
  "description": "Contract-first type-safe HTTP client with Zod validation",
  "keywords": [
    "api-client",
    "contract-first",
    "http-client",
    "type-safe",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/KeterVM/zodsei#readme",
  "bugs": {
    "url": "https://github.com/KeterVM/zodsei/issues"
  },
  "license": "MIT",
  "author": "KeterVM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeterVM/zodsei.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vue-query": {
      "types": "./dist/vue-query.d.ts",
      "import": "./dist/vue-query.js",
      "default": "./dist/vue-query.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:dev": "vp test --watch",
    "test:coverage": "vp test run --coverage",
    "test:ui": "vp test --ui",
    "type-check": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check && vp test run",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run check && bun run build"
  },
  "dependencies": {
    "axios": "^1.21.0"
  },
  "devDependencies": {
    "@tanstack/vue-query": "^5.106.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "vitest": "5.1.0",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@tanstack/vue-query": "^5.106.1",
    "vue": "^3.3.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@tanstack/vue-query": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.3.14"
}
